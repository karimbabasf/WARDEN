@@ -0,0 +1,199 @@
+//
+//  WardenSectionView.swift
+//  boringNotch
+//
+//  The WARDEN section: one globe per live AI-coding agent, in the notch.
+//
+//  WHY THIS IS A WEB VIEW AND NOT SWIFTUI. The requirement is that these globes are the
+//  SAME globes WARDEN's own menu-bar HUD draws, not a lookalike. A globe there is a
+//  transmission `meshPhysicalMaterial` gem inside a wireframe shell with a point-cloud
+//  lattice and an emissive core past 1.0, resolved by a bloom pass against an environment
+//  probe. Restating that in SceneKit would put a second renderer of one object behind a
+//  language boundary, where the two cannot share code or be tested against each other,
+//  and WARDEN already learned what that costs: it once had a cheaper HUD globe beside its
+//  war-room one and they "drifted on sight". So this section runs WARDEN's own bundle,
+//  served by WARDEN itself over loopback. Same code, therefore same globes, by
+//  construction rather than by discipline.
+//
+//  HOW IT ATTACHES. WARDEN writes `~/.warden/bridge.json` at 0600 with the port it chose
+//  and a token minted for that launch. We read it, hand the token to the page through an
+//  injected global (never the URL, which would keep it in history), and point the view at
+//  the loopback origin. No WARDEN, no file: the section says so and keeps watching.
+
+import SwiftUI
+import WebKit
+
+// MARK: - Handshake
+
+/// What WARDEN wrote for us this launch.
+struct WardenHandshake: Codable, Equatable {
+    let port: Int
+    let token: String
+}
+
+/// Reads and watches `~/.warden/bridge.json`.
+///
+/// The REAL home directory, not `NSHomeDirectory()`. We are sandboxed, so that call
+/// answers with the container (`~/Library/Containers/theboringteam.boringnotch/Data`) and
+/// the handshake is not in it. `getpwuid` is the honest one, and it is only readable at
+/// all because of the read-only home-relative exception this fork adds for `/.warden/`.
+@MainActor
+final class WardenBridgeWatcher: ObservableObject {
+    @Published private(set) var handshake: WardenHandshake?
+
+    private var timer: Timer?
+
+    static var handshakeURL: URL {
+        let home: String
+        if let pw = getpwuid(getuid()), let dir = pw.pointee.pw_dir {
+            home = String(cString: dir)
+        } else {
+            home = NSHomeDirectory()
+        }
+        return URL(fileURLWithPath: home)
+            .appendingPathComponent(".warden")
+            .appendingPathComponent("bridge.json")
+    }
+
+    init() {
+        reload()
+        // Polled rather than watched with a DispatchSource. A file watcher needs an open
+        // descriptor on a file that may not exist yet, and has to be torn down and rebuilt
+        // every time WARDEN rewrites it; the state we are tracking changes at most once
+        // per WARDEN launch, so 2s of latency on it costs nothing a person can see.
+        timer = Timer.scheduledTimer(withTimeInterval: 2.0, repeats: true) { [weak self] _ in
+            Task { @MainActor in self?.reload() }
+        }
+    }
+
+    deinit { timer?.invalidate() }
+
+    func reload() {
+        guard let data = try? Data(contentsOf: Self.handshakeURL),
+              let next = try? JSONDecoder().decode(WardenHandshake.self, from: data)
+        else {
+            if handshake != nil { handshake = nil }
+            return
+        }
+        // Only publish a CHANGE. Republishing an identical handshake every 2s would
+        // rebuild the web view on a timer and the scene would restart forever.
+        if next != handshake { handshake = next }
+    }
+}
+
+// MARK: - Web view
+
+/// WARDEN's HUD bundle, hosted.
+///
+/// The web view is CACHED across mounts rather than built per appearance. Switching tabs
+/// takes this view out of the hierarchy, and a fresh `WKWebView` each time would mean a
+/// fresh WebGL context, a fresh React tree and a fresh Three scene on every switch: the
+/// globes would fade up from nothing each time the tab is picked. WARDEN pre-warms its own
+/// HUD window for exactly this reason, and a section that re-boots on every glance would
+/// throw that away. One view per handshake, reused; a new handshake (WARDEN restarted)
+/// retires the old one, because its token is dead and its event stream is closed.
+@MainActor
+enum WardenWebViewCache {
+    private static var cached: (key: WardenHandshake, view: WKWebView)?
+
+    static func view(for handshake: WardenHandshake, coordinator: WardenWebView.Coordinator) -> WKWebView {
+        if let c = cached, c.key == handshake { return c.view }
+
+        let config = WKWebViewConfiguration()
+        // The token, before the page's own scripts run. `atDocumentStart` matters: the
+        // HUD opens its event stream on mount, and a token that arrived after that would
+        // mean a first connection rejected and a visible empty frame.
+        let script = WKUserScript(
+            source: "window.__WARDEN_BRIDGE__ = { token: \"\(handshake.token)\" };",
+            injectionTime: .atDocumentStart,
+            forMainFrameOnly: true
+        )
+        config.userContentController.addUserScript(script)
+
+        let webView = WKWebView(frame: .zero, configuration: config)
+        webView.navigationDelegate = coordinator
+
+        // Transparent, so the notch panel's own material shows through instead of the web
+        // view painting an opaque white rectangle over it while the scene boots.
+        webView.setValue(false, forKey: "drawsBackground")
+        if #available(macOS 12.0, *) {
+            webView.underPageBackgroundColor = .clear
+        }
+        webView.allowsMagnification = false
+        // A menu-bar panel is not a browser: rubber-band scrolling on an element that
+        // never overflows reads as the section coming loose from the notch.
+        webView.enclosingScrollView?.verticalScrollElasticity = .none
+
+        if let url = URL(string: "http://127.0.0.1:\(handshake.port)/hud.html") {
+            webView.load(URLRequest(url: url))
+        }
+        cached = (handshake, webView)
+        return webView
+    }
+}
+
+struct WardenWebView: NSViewRepresentable {
+    let handshake: WardenHandshake
+
+    func makeCoordinator() -> Coordinator { Coordinator() }
+
+    final class Coordinator: NSObject, WKNavigationDelegate {
+        /// Refuse to navigate anywhere but the bridge.
+        ///
+        /// The page is ours and does not link out, so this can never fire in normal use.
+        /// It is here because the alternative is a section that would follow a link if one
+        /// ever appeared, inside a panel with no address bar and no back button, where the
+        /// user could not see where they had been taken.
+        func webView(
+            _ webView: WKWebView,
+            decidePolicyFor navigationAction: WKNavigationAction,
+            decisionHandler: @escaping (WKNavigationActionPolicy) -> Void
+        ) {
+            guard let host = navigationAction.request.url?.host,
+                  host == "127.0.0.1" || host == "localhost"
+            else {
+                decisionHandler(.cancel)
+                return
+            }
+            decisionHandler(.allow)
+        }
+    }
+
+    func makeNSView(context: Context) -> WKWebView {
+        WardenWebViewCache.view(for: handshake, coordinator: context.coordinator)
+    }
+
+    func updateNSView(_ webView: WKWebView, context: Context) {
+        // Nothing to push: the cache is keyed on the handshake, and the section view is
+        // keyed on it too, so a change of handshake arrives as a new view, not an update.
+    }
+}
+
+// MARK: - Section
+
+/// The tab's content: the globes when WARDEN is up, an honest line when it is not.
+struct WardenSectionView: View {
+    @StateObject private var watcher = WardenBridgeWatcher()
+
+    var body: some View {
+        Group {
+            if let handshake = watcher.handshake {
+                WardenWebView(handshake: handshake)
+                    // Keyed on the handshake so a WARDEN restart builds a fresh view
+                    // rather than reusing one holding a dead token and a closed stream.
+                    .id("\(handshake.port)-\(handshake.token)")
+            } else {
+                VStack(spacing: 6) {
+                    Image(systemName: "circle.hexagongrid")
+                        .font(.system(size: 18, weight: .light))
+                        .foregroundStyle(.tertiary)
+                    Text("WARDEN is not running")
+                        .font(.caption)
+                        .foregroundStyle(.secondary)
+                }
+                .frame(maxWidth: .infinity, maxHeight: .infinity)
+            }
+        }
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+    }
+}
