+//
+//  WardenLauncher.swift
+//  boringNotch
+//
+//  Start WARDEN from the notch, for the state the section spends most of its life in.
+//
+//  The section could already SEE that WARDEN was down and could only say so, which left
+//  the one obvious next move (start it) somewhere else entirely: the Dock, Spotlight, or
+//  a login agent that only fires at boot. This is that move, on the surface that noticed.
+//
+//  WHY LAUNCHSERVICES AND NOT `open`. We are sandboxed. A spawned `/usr/bin/open` would
+//  inherit our sandbox and would need a path we are allowed to read, and /Applications is
+//  not one of them: the only file exception this fork carries is read-only `~/.warden/`.
+//  `NSWorkspace` asks LaunchServices instead, which is a lookup by bundle id rather than
+//  a file read, and launching another app is something the sandbox has always allowed.
+//  It also means the button works wherever WARDEN is installed, not only in /Applications.
+//
+//  WHY NO `--hidden`, THOUGH IT IS THE FLAG YOU WOULD REACH FOR. WARDEN reads `--hidden`
+//  from its own argv and skips the war-room window when it is there (`lib.rs ::
+//  starts_hidden`), which is exactly what a click in the notch wants: the globes IN THE
+//  NOTCH, not a 3D window in front of whatever the operator was doing. It cannot be had
+//  from here. `NSWorkspace.OpenConfiguration.arguments` is DROPPED for a sandboxed
+//  caller: the same test binary, signed twice, launches WARDEN as `warden --hidden`
+//  without the sandbox entitlement and as bare `warden` with it. So the argument is left
+//  off rather than passed and silently ignored, and WARDEN opens its window on this
+//  launch the way it does on any other. Getting the window to stay down needs a route
+//  that is not argv (WARDEN honouring something else, or the unsandboxed XPC helper
+//  doing the launch), and neither belongs behind a button in an empty state.
+
+import AppKit
+import SwiftUI
+
+@MainActor
+final class WardenLauncher: ObservableObject {
+    enum Phase: Equatable {
+        case idle
+        case launching
+        /// A line short enough for the notch, already written for a person.
+        case failed(String)
+    }
+
+    @Published private(set) var phase: Phase = .idle
+
+    /// WARDEN's bundle id (`src-tauri/tauri.conf.json`). The identity we ask
+    /// LaunchServices for, so a WARDEN that lives somewhere other than /Applications
+    /// still starts.
+    private static let bundleIdentifier = "com.warden.app"
+
+    /// Where WARDEN is, or nil when it is not installed at all.
+    ///
+    /// Recomputed on every read rather than cached: WARDEN can be installed, moved or
+    /// deleted while boring.notch is running, and a cached answer would leave a button
+    /// that starts nothing, or no button beside a WARDEN that is right there.
+    static var installedURL: URL? {
+        NSWorkspace.shared.urlForApplication(withBundleIdentifier: bundleIdentifier)
+    }
+
+    /// Is WARDEN's process up right now?
+    ///
+    /// Only used to tell two failures apart when a launch times out, because they need
+    /// different things from the operator: a WARDEN that never started is a launch
+    /// problem, and a WARDEN that is running without a bridge is WARDEN's problem.
+    private static var isRunning: Bool {
+        !NSWorkspace.shared.runningApplications
+            .filter { $0.bundleIdentifier == bundleIdentifier }
+            .isEmpty
+    }
+
+    /// How long to wait for `~/.warden/bridge.json` before calling it a failure.
+    ///
+    /// WARDEN writes the handshake in well under a second from cold, and the watcher
+    /// that reads it is quickened to 250ms for the same window, so this is not a
+    /// duration anybody should ever see. It is the backstop for the case where WARDEN
+    /// starts and its bridge does not, which would otherwise be a spinner forever.
+    private static let handshakeTimeout: Duration = .seconds(15)
+
+    private var timeout: Task<Void, Never>?
+
+    /// Start WARDEN, and wait for it to say it is up.
+    ///
+    /// "Up" is the HANDSHAKE, not the launch: LaunchServices reports success the moment
+    /// the process is created, which is several steps before there is anything for the
+    /// section to attach to. So the spinner is ended by `handshakeArrived()`, called by
+    /// the section when the file lands, and never by this method.
+    func launch() {
+        guard phase != .launching else { return }
+        guard let url = Self.installedURL else {
+            phase = .failed("WARDEN is not installed")
+            return
+        }
+
+        phase = .launching
+
+        let configuration = NSWorkspace.OpenConfiguration()
+        // Do not ASK for the front. The operator clicked a panel hanging off the menu
+        // bar, so they were in the middle of something else. WARDEN will raise its own
+        // window anyway (see the note at the top of this file), but that is WARDEN's
+        // decision about WARDEN, and it is the one that a person can take up with it.
+        configuration.activates = false
+
+        NSWorkspace.shared.openApplication(at: url, configuration: configuration) { [weak self] _, error in
+            guard let error else { return }
+            NSLog("WARDEN: launch failed: \(error.localizedDescription)")
+            Task { @MainActor in
+                self?.fail("WARDEN would not start")
+            }
+        }
+
+        timeout = Task { [weak self] in
+            try? await Task.sleep(for: Self.handshakeTimeout)
+            guard !Task.isCancelled else { return }
+            self?.fail(Self.isRunning ? "WARDEN started, but its bridge did not"
+                                      : "WARDEN did not come up")
+        }
+    }
+
+    /// The handshake landed: the section is about to swap to the globes.
+    ///
+    /// Resetting to `.idle` rather than adding a `.running` phase, because the launcher
+    /// is only ever on screen while WARDEN is down. A phase for a state this view never
+    /// draws would be a lie kept warm for nobody.
+    func handshakeArrived() {
+        timeout?.cancel()
+        timeout = nil
+        phase = .idle
+    }
+
+    private func fail(_ message: String) {
+        timeout?.cancel()
+        timeout = nil
+        phase = .failed(message)
+    }
+
+    deinit { timeout?.cancel() }
+}
