+    /// The resting cadence, and the one used while a launch we started is in flight.
+    private static let idleInterval: TimeInterval = 2.0
+    private static let quickInterval: TimeInterval = 0.25
+
+    /// When to stop polling fast, or nil when we are not.
+    private var quickenUntil: Date?
