-        timer = Timer.scheduledTimer(withTimeInterval: 2.0, repeats: true) { [weak self] _ in
-            Task { @MainActor in self?.reload() }
-        }
+        schedule(every: Self.idleInterval)
     }
 
     deinit { timer?.invalidate() }
 
+    /// Poll fast for a moment, because we know the file is about to change.
+    ///
+    /// 2s is the right cadence for a handshake that is rewritten once per WARDEN launch,
+    /// and the wrong one for the single moment we STARTED that launch ourselves. WARDEN
+    /// writes the file in well under a second, so at the resting cadence the globes would
+    /// arrive up to two seconds after WARDEN was already serving them, and a button whose
+    /// result lands two seconds late reads as a button that did not work.
+    func quicken(for duration: TimeInterval) {
+        quickenUntil = Date().addingTimeInterval(duration)
+        schedule(every: Self.quickInterval)
+    }
+
+    private func schedule(every interval: TimeInterval) {
+        timer?.invalidate()
+        timer = Timer.scheduledTimer(withTimeInterval: interval, repeats: true) { [weak self] _ in
+            Task { @MainActor in self?.tick() }
+        }
+    }
+
+    private func tick() {
+        reload()
+        // Drop back as soon as the fast window has done its job, whether that is because
+        // the handshake landed or because it never will. Nothing here should leave a
+        // 250ms timer running against a file that changes once a day.
+        guard let until = quickenUntil else { return }
+        if handshake != nil || Date() >= until {
+            quickenUntil = nil
+            schedule(every: Self.idleInterval)
+        }
+    }
+
     func reload() {
         guard let data = try? Data(contentsOf: Self.handshakeURL),
               let next = try? JSONDecoder().decode(WardenHandshake.self, from: data)
