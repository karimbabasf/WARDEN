+// MARK: - Empty state
+
+/// What the section says when WARDEN is down, and the one thing it offers to do about it.
+private struct WardenIdleView: View {
+    @ObservedObject var launcher: WardenLauncher
+    let start: () -> Void
+
+    /// No WARDEN on the machine means no button. An enabled button that cannot work, or
+    /// a disabled one with no way to enable it, would both be worse than a plain line
+    /// saying what is actually missing.
+    private var isInstalled: Bool { WardenLauncher.installedURL != nil }
+
+    private var message: String {
+        switch launcher.phase {
+        case .launching: return "Starting WARDEN"
+        case .failed(let reason): return reason
+        case .idle: return isInstalled ? "WARDEN is not running" : "WARDEN is not installed"
+        }
+    }
+
+    var body: some View {
+        VStack(spacing: 8) {
+            Image(systemName: "circle.hexagongrid")
+                .font(.system(size: 18, weight: .light))
+                .foregroundStyle(.tertiary)
+
+            Text(message)
+                .font(.caption)
+                .foregroundStyle(.secondary)
+                // Crossfade rather than a cut, because the line changes UNDER a pointer
+                // that has not moved: without it, "WARDEN is not running" becoming
+                // "Starting WARDEN" reads as a glitch rather than an answer.
+                .contentTransition(.opacity)
+                .animation(.easeOut(duration: 0.15), value: message)
+
+            if launcher.phase == .launching {
+                ProgressView()
+                    .controlSize(.small)
+                    // Held to the button's own height so the swap does not move the line
+                    // above it. A caption that jumps when you click is the interface
+                    // losing its place, not reporting progress.
+                    .frame(height: 22)
+            } else if isInstalled {
+                Button(startTitle, action: start)
+                    .buttonStyle(WardenStartButtonStyle())
+            }
+        }
+    }
+
+    /// A failed launch offers the same action under a different word, because "Start
+    /// WARDEN" after being told it would not start reads as if the first click was
+    /// never received.
+    private var startTitle: String {
+        if case .failed = launcher.phase { return "Try again" }
+        return "Start WARDEN"
+    }
+}
+
+/// A pill for the notch's black: a hairline over a fill that lifts on hover.
+///
+/// Its own style rather than `BouncingButtonStyle`, which is built for the media
+/// controls: 12pt of padding and a 0.9 spring under a caption in an empty state would be
+/// a control shouting over the line that explains it.
+private struct WardenStartButtonStyle: ButtonStyle {
+    func makeBody(configuration: Configuration) -> some View {
+        Pill(configuration: configuration)
+    }
+
+    private struct Pill: View {
+        let configuration: ButtonStyleConfiguration
+        @State private var isHovering = false
+
+        var body: some View {
+            configuration.label
+                .font(.caption.weight(.medium))
+                .foregroundStyle(isHovering ? HierarchicalShapeStyle.primary : HierarchicalShapeStyle.secondary)
+                .padding(.horizontal, 10)
+                .padding(.vertical, 4)
+                .background(
+                    Capsule()
+                        .fill(.white.opacity(isHovering ? 0.12 : 0.06))
+                        .strokeBorder(.white.opacity(0.08), lineWidth: 1)
+                )
+                // The press is the only part that has to be instant: it is the interface
+                // saying it heard the click, and it is over before the launch it starts.
+                .scaleEffect(configuration.isPressed ? 0.97 : 1)
+                .animation(.easeOut(duration: 0.12), value: configuration.isPressed)
+                .onHover { hovering in
+                    withAnimation(.easeOut(duration: 0.15)) { isHovering = hovering }
+                }
+        }
     }
 }
