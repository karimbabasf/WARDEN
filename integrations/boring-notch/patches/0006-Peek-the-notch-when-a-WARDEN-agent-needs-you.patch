index 0000000..d1671a7
--- /dev/null
+++ b/boringNotch/components/Warden/WardenAttentionMonitor.swift
@@ -0,0 +1,203 @@
+//
+//  WardenAttentionMonitor.swift
+//  boringNotch
+//
+//  "An agent has just stopped on you." The notch says it now, and WARDEN's own menu-bar
+//  panel stays down while we are the one saying it.
+//
+//  WHY THIS IS NOT DONE IN THE WEB VIEW. The section already receives WARDEN's radar
+//  state, so it knows perfectly well when a globe turns red. It just cannot TELL anyone:
+//  the page's event stream is open only while the section is on screen (that is what
+//  keeps a hidden WebGL scene from driving a 120Hz display all day), and the whole point
+//  of an alert is that it arrives when you are NOT looking at the notch. So this is a
+//  native client, held open for the life of the app, next to the web view rather than
+//  inside it.
+//
+//  THE HELD CONNECTION IS ALSO THE ANSWER TO A SECOND QUESTION. WARDEN used to open its
+//  own panel under the menu bar whenever an agent blocked. With the section running,
+//  that is the same alert twice, one of them covering the other. WARDEN decides which
+//  surface speaks by asking whether anybody is holding this stream (`bridge.rs ::
+//  host_attached`), so connecting IS the handover and disconnecting gives it straight
+//  back. There is no second setting to keep in sync, and no state to get stuck in: kill
+//  boring.notch and WARDEN's panel is answering again on the next block.
+//
+
+import Combine
+import Defaults
+import Foundation
+
+// MARK: - Wire types
+
+/// One agent that has just stopped on the operator.
+///
+/// `reason` is WARDEN's CLOSED vocabulary (`question` / `approval` / `input`), never a
+/// harness's own dialog text: see `radar/awaiting.rs`. Optional because an older
+/// transcript can carry the block without the reason.
+struct WardenAwaitingAgent: Decodable, Equatable {
+    let id: String
+    let name: String
+    let harness: String
+    let reason: String?
+
+    /// The line the notch shows. Written for the operator, mirroring
+    /// `web/viz/shared/lib/awaitingCopy.ts` so the notch and the globes agree on words.
+    var line: String {
+        switch reason {
+        case "question": return "asked you a question"
+        case "approval": return "needs your approval"
+        default: return "needs your input"
+        }
+    }
+}
+
+/// The alert itself: who just blocked, and how many are waiting in total.
+struct WardenAttentionAlert: Decodable, Equatable {
+    let agents: [WardenAwaitingAgent]
+    /// EVERY agent waiting, not just the new ones. "3 agents need you" is the line the
+    /// operator acts on; the transition is only what decided to speak.
+    let awaiting: Int
+}
+
+/// The SSE envelope WARDEN publishes.
+private struct WardenBridgeEvent: Decodable {
+    let event: String
+}
+
+private struct WardenAttentionEnvelope: Decodable {
+    let event: String
+    let payload: WardenAttentionAlert
+}
+
+// MARK: - Monitor
+
+@MainActor
+final class WardenAttentionMonitor: ObservableObject {
+    static let shared = WardenAttentionMonitor()
+
+    /// Fires once per transition into awaiting. Not `@Published`: an alert is an EVENT,
+    /// and a published value would re-deliver the last one to every new subscriber.
+    let alerts = PassthroughSubject<WardenAttentionAlert, Never>()
+
+    /// Is the stream up right now? Read by the settings pane so "WARDEN is not running"
+    /// is a visible state rather than a silent one.
+    @Published private(set) var connected = false
+
+    private var task: Task<Void, Never>?
+    private var enabledCancellable: AnyCancellable?
+
+    /// A session of our own, because the default one's 60s request timeout would tear
+    /// down a stream that is idle by design. WARDEN's keep-alive comments would usually
+    /// beat it, but "usually" is not a reason to leave the trap set.
+    private lazy var session: URLSession = {
+        let config = URLSessionConfiguration.ephemeral
+        config.timeoutIntervalForRequest = .infinity
+        config.timeoutIntervalForResource = .infinity
+        config.waitsForConnectivity = false
+        config.httpShouldUsePipelining = false
+        return URLSession(configuration: config)
+    }()
+
+    private init() {
+        // The toggle is the operator's way to hand the alert back to WARDEN's own panel,
+        // and it has to act at once in both directions: turning it off must DROP the
+        // connection, because the connection is what tells WARDEN to stay quiet.
+        enabledCancellable = Defaults.publisher(.wardenAttentionAlerts)
+            .sink { [weak self] change in
+                Task { @MainActor in
+                    if change.newValue { self?.start() } else { self?.stop() }
+                }
+            }
+    }
+
+    func start() {
+        guard Defaults[.wardenAttentionAlerts], task == nil else { return }
+        task = Task { [weak self] in await self?.run() }
+    }
+
+    func stop() {
+        task?.cancel()
+        task = nil
+        connected = false
+    }
+
+    /// Connect, read, reconnect. Forever, until cancelled.
+    ///
+    /// Every exit from `readStream` is a reconnect, not a failure to report: WARDEN not
+    /// being up is the ordinary case (it is a separate app the operator starts when they
+    /// want it), so this waits and asks again rather than surfacing an error nobody can
+    /// act on. The backoff is what keeps that from being a poll: 2s while WARDEN is
+    /// absent, and no delay at all after a stream that had actually been running, so a
+    /// WARDEN restart is picked up on the next handshake rather than a backoff later.
+    private func run() async {
+        var backoff: UInt64 = 2
+        while !Task.isCancelled {
+            guard let handshake = Self.readHandshake(),
+                  let url = URL(string: "http://127.0.0.1:\(handshake.port)/attention")
+            else {
+                try? await Task.sleep(for: .seconds(2))
+                continue
+            }
+            var request = URLRequest(url: url)
+            request.setValue("Bearer \(handshake.token)", forHTTPHeaderField: "Authorization")
+            request.setValue("text/event-stream", forHTTPHeaderField: "Accept")
+            request.timeoutInterval = .infinity
+
+            let ranClean = await readStream(request)
+            if Task.isCancelled { return }
+            backoff = ranClean ? 1 : min(backoff * 2, 10)
+            try? await Task.sleep(for: .seconds(Double(backoff)))
+        }
+    }
+
+    /// Read one connection to exhaustion. Returns whether it ever actually delivered.
+    private func readStream(_ request: URLRequest) async -> Bool {
+        var delivered = false
+        do {
+            let (bytes, response) = try await session.bytes(for: request)
+            guard let http = response as? HTTPURLResponse, http.statusCode == 200 else {
+                return false
+            }
+            connected = true
+            defer { connected = false }
+
+            // Minimal SSE: WARDEN sends one JSON object per `data:` line and never
+            // splits one across lines, so there is no multi-line frame to reassemble.
+            // Everything else on the wire (`:` keep-alives, blank separators) is skipped
+            // rather than parsed.
+            for try await line in bytes.lines {
+                if Task.isCancelled { break }
+                guard let json = line.dropPrefixIfPresent("data:")?
+                    .trimmingCharacters(in: .whitespaces)
+                    .data(using: .utf8)
+                else { continue }
+                delivered = true
+                guard let kind = try? JSONDecoder().decode(WardenBridgeEvent.self, from: json),
+                      kind.event == "warden_attention",
+                      let envelope = try? JSONDecoder().decode(WardenAttentionEnvelope.self, from: json)
+                else { continue }
+                alerts.send(envelope.payload)
+            }
+        } catch {
+            return delivered
+        }
+        return delivered
+    }
+
+    /// `{port, token}`, written by WARDEN at 0600 for this launch.
+    ///
+    /// The REAL home directory, not `NSHomeDirectory()`: we are sandboxed, so that call
+    /// answers with our container. Same read `WardenBridgeWatcher` does, and it works for
+    /// the same reason: the read-only home-relative exception this fork adds for
+    /// `/.warden/`.
+    private static func readHandshake() -> WardenHandshake? {
+        guard let data = try? Data(contentsOf: WardenBridgeWatcher.handshakeURL) else { return nil }
+        return try? JSONDecoder().decode(WardenHandshake.self, from: data)
+    }
+}
+
+private extension String {
+    /// The line's payload when it is a `data:` line, `nil` otherwise.
+    func dropPrefixIfPresent(_ prefix: String) -> String? {
+        hasPrefix(prefix) ? String(dropFirst(prefix.count)) : nil
+    }
+}
