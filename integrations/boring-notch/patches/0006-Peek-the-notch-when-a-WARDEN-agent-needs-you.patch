+    /// An agent has just stopped on the operator: show them, then leave.
+    ///
+    /// This is WARDEN's own auto-summon, moved into the notch, and it keeps the three
+    /// properties that made that one a notification rather than an interruption. It
+    /// fires on the TRANSITION (WARDEN already folded the level away before publishing).
+    /// It takes no focus: opening the notch moves no window and steals no keystroke.
+    /// And it leaves on its own clock, six seconds, the same number the panel uses,
+    /// unless the pointer arrived, which is the operator answering it.
+    @MainActor
+    private func peekWardenAlert(_ alert: WardenAttentionAlert) {
+        guard Defaults[.wardenAttentionAlerts], !coordinator.firstLaunch else { return }
+        let viewModel = notchViewModelUnderMouse()
+        // Already open is already answered: the fleet is on screen, and re-opening a
+        // notch the operator is using would yank the tab out from under them.
+        guard viewModel.notchState == .closed else { return }
+
+        // Cancel the shortcut's own close clock: it would shut this peek early.
+        closeNotchTask?.cancel()
+        closeNotchTask = nil
+
+        coordinator.currentView = .warden
+        withAnimation(.smooth) { viewModel.open() }
+        NSLog("WARDEN: \(alert.awaiting) agent(s) waiting; peeking the notch")
+
+        wardenPeekTask?.cancel()
+        wardenPeekTask = Task { [weak viewModel] in
+            try? await Task.sleep(for: .seconds(6))
+            guard !Task.isCancelled, let viewModel else { return }
+            await MainActor.run {
+                // Reaching for it cancels the clock. Hover is the only "the operator is
+                // looking at this" signal a notch has, and closing under the pointer is
+                // the one way to make a helpful peek hostile.
+                guard !viewModel.isMouseHovering(), viewModel.notchState == .open else { return }
+                withAnimation(.smooth) { viewModel.close() }
+            }
+        }
+    }
+
+    /// Put the panel away because the section asked: a globe was clicked and the
