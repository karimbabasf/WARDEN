+    /// decision, and the notch sitting over the window it just summoned was the whole of
+    /// what "delayed" meant.
+    @MainActor
+    private func closeWardenPeek() {
+        wardenPeekTask?.cancel()
+        wardenPeekTask = nil
+        let viewModel = notchViewModelUnderMouse()
+        guard viewModel.notchState == .open else { return }
+        withAnimation(.smooth) { viewModel.close() }
+    }
