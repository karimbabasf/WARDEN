+// MARK: - Page -> host
+
+/// The section's script-message handler.
+///
+/// A singleton because `WKUserContentController` RETAINS its handler and the web view is
+/// cached for the life of the app: a per-view handler would keep a retired coordinator
+/// (and, through it, whatever it referenced) alive behind every WARDEN restart.
+///
+/// It reads exactly one action and ignores everything else. The page is ours, but a
+/// script-message handler is still a hole in the sandbox around a web view, so it stays
+/// a closed vocabulary rather than anything shaped like a command.
+@MainActor
+final class WardenHostBridge: NSObject, WKScriptMessageHandler {
+    static let shared = WardenHostBridge()
+
+    func userContentController(
+        _ userContentController: WKUserContentController,
+        didReceive message: WKScriptMessage
+    ) {
+        guard let body = message.body as? [String: Any],
+              body["action"] as? String == "close"
+        else { return }
+        NotificationCenter.default.post(name: Notification.Name.wardenCloseNotch, object: nil)
+    }
+}
+
 // MARK: - Web view
 
 /// WARDEN's HUD bundle, hosted.
@@ -123,6 +149,13 @@ enum WardenWebViewCache {
             forMainFrameOnly: true
         )
         config.userContentController.addUserScript(script)
+        // The one channel that runs page -> host. The page uses it for exactly one
+        // thing: "I have been clicked, put your panel away", because a globe click means
+        // take me to that terminal and the notch was sitting over the window it had just
+        // asked for. WARDEN's own panel funnels away on that click; this is the
+        // section's equivalent, and it is a REQUEST rather than the page dismissing
+        // itself, because the panel is the host's and only the host can bring it back.
+        config.userContentController.add(WardenHostBridge.shared, name: "wardenHost")
 
         let webView = WKWebView(frame: .zero, configuration: config)
         webView.navigationDelegate = coordinator
