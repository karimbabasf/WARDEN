# WARDEN brain - Near AI cloud (OpenAI-compatible Chat Completions).
# Fill these in your project-local .env (gitignored). Never commit real keys.
WARDEN_BRAIN_API_KEY=
WARDEN_BRAIN_BASE_URL=          # e.g. https://glm-5-2.completions.near.ai/v1 direct, or https://cloud-api.near.ai/v1 gateway
WARDEN_BRAIN_DIAGNOSE_MODEL=    # e.g. z-ai/glm-5.2
WARDEN_BRAIN_VERIFY_MODEL=      # e.g. z-ai/glm-5.2
# (OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_API_BASE work as fallbacks — see util.rs)

# Optional brain knobs
WARDEN_BRAIN_STRUCTURED_OUTPUT=json_object   # json_schema | json_object | prompt
WARDEN_BRAIN_STREAM=1
#WARDEN_BRAIN_TRANSPORT=        # reqwest (default) | curl
#WARDEN_BRAIN_TIMEOUT_SECS=75
#WARDEN_BRAIN_CURL_TIMEOUT_SECS=

# Optional overrides — core
WARDEN_DB_PATH=~/.warden/warden.db
#WARDEN_CONFIG_PATH=~/.warden/config.toml

# Optional overrides — ingest sources
WARDEN_CLAUDE_PROJECTS=~/.claude/projects
#WARDEN_CLAUDE_SESSIONS=
#WARDEN_CLAUDE_MD=~/.claude/CLAUDE.md
#WARDEN_CLAUDE_DESKTOP_SESSIONS=~/Library/Application Support/Claude/local-agent-mode-sessions
#WARDEN_CODEX_SESSIONS=~/.codex/sessions
#WARDEN_CODEX_ARCHIVED_SESSIONS=~/.codex/archived_sessions
#WARDEN_MAX_FILES=              # cap backfill scope (testing)
#WARDEN_WATCH_DEBOUNCE_MS=

# Optional tuning — RADAR liveness/recompute (defaults in src-tauri/src/radar/, scheduler.rs)
#WARDEN_RADAR_TICK_MS=
#WARDEN_RADAR_DEBOUNCE_MS=
#WARDEN_RADAR_CODEX_STALE_HRS=
#WARDEN_RADAR_ROOT_IDLE_SECS=
#WARDEN_RADAR_WORKING_MS=
#WARDEN_RADAR_WORKING_STALE_SECS=
#WARDEN_RADAR_SUBAGENT_TERMINATE_MS=
#WARDEN_RADAR_TERMINATE_GRACE_MS=

# Optional tuning — Habits
#WARDEN_HABITS_TICK_MS=
#WARDEN_HABITS_DEBOUNCE_MS=
#WARDEN_HABITS_ERASE_WINDOW=

# Optional — DOSSIER
#WARDEN_DOSSIER_DISABLE_EMBEDDINGS=1        # force heuristic (no fastembed) path
#WARDEN_DOSSIER_ENABLE_EMBEDDINGS_IN_TEST=1

# Dev
#WARDEN_DEV_PORT=               # moves vite devServer + tauri devUrl in lockstep (default 1421)
